# 禁止直接访问数据文件（myspace_data.json 等）
<FilesMatch "\.(json|bak|log|sql)$">
  Require all denied
</FilesMatch>
# 防缓存，发布后立即看到最新版本
<IfModule mod_headers.c>
  <FilesMatch "\.(php)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>
